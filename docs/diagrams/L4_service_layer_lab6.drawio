        </mxCell>
        <mxCell id="api" value="HTTP Server&#xa;delivery/http/server.go&#xa;/health, /info&#xa;future backend for GUI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="240" height="120" as="geometry" />
