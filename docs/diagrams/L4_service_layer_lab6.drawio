        <mxCell id="title" value="&lt;b&gt;L4 — Компонент бизнес-логики и сервисный слой (Lab 6)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#0b5394;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="CLI работает напрямую с сервисами. API-компонент пока реализует health/info и подготовлен как backend для будущего GUI. AppointmentService параметризуется business-настройкой из config." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1550" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="CommandApp&#xa;delivery/cli/command.go&#xa;patient / schedule / appointment / visit&#xa;Команды и флаги" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
