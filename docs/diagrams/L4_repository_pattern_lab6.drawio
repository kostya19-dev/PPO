  <diagram id="L4-repo-lab6" name="L4 Repository Lab6">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;L4 — Компонент доступа к данным (Repository pattern, Lab 6)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#0b5394;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Интерфейсы репозиториев из usecase зависят только от domain-сущностей. PostgreSQL-реализации используют Squirrel, *sql.DB и helper-функции scanXxx." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="i_patient" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&#xa;PatientRepository&#xa;Save(ctx,*domain.Patient) error&#xa;FindByID(ctx,uuid.UUID) (*domain.Patient,error)&#xa;FindAll(ctx) ([]*domain.Patient,error)&#xa;FindByEmail(ctx,string) (*domain.Patient,error)&#xa;Update(ctx,*domain.Patient) error&#xa;Delete(ctx,uuid.UUID) error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="i_appointment" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&#xa;AppointmentRepository&#xa;Save(ctx,*domain.Appointment) error&#xa;FindByID(ctx,uuid.UUID) (*domain.Appointment,error)&#xa;FindAll(ctx) ([]*domain.Appointment,error)&#xa;FindByPatient(ctx,uuid.UUID) ([]*domain.Appointment,error)&#xa;CheckSlotBusy(ctx,uuid.UUID,time.Time) (bool,error)&#xa;Update(ctx,*domain.Appointment) error&#xa;Delete(ctx,uuid.UUID) error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="100" width="330" height="200" as="geometry" />
        </mxCell>
        <mxCell id="i_schedule" value="&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&#xa;ScheduleRepository&#xa;Save(ctx,*domain.ScheduleSlot) error&#xa;FindByDoctorID(ctx,uuid.UUID) ([]*domain.ScheduleSlot,error)&#xa;FindFreeSlots(ctx,uuid.UUID,time.Time) ([]*domain.ScheduleSlot,error)&#xa;Update(ctx,*domain.ScheduleSlot) error&#xa;Delete(ctx,uuid.UUID) error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="100" width="320" height="180" as="geometry" />
